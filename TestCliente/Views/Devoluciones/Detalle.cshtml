@model TestCliente.Models.Devoluciones.DevolucionDetalleViewModel
@{
    ViewBag.Title = "Detalle de devolución";
}
<h2 class="mt-3 mb-3">Detalle de la devolución N° @Model.IdDevolucion</h2>

@Html.Partial("_Mensajes")

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No hay productos para mostrar.</p>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Id producto</th>
                <th>Producto</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Precio de venta</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.IdProducto</td>
                    <td>@i.NombreProducto</td>
                    <td class="text-end">@i.Cantidad</td>
                    <td class="text-end">@i.PrecioVenta.ToString("N2")</td>
                    <td class="text-end">@i.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary" })
