@model TestCliente.Models.Devoluciones.NuevaDevolucionViewModel
@{
    ViewBag.Title = "Nueva devolución";
}
<h2 class="mt-3 mb-3">Nueva devolución</h2>

@Html.Partial("_Mensajes")

@using (Html.BeginForm("Nueva", "Devoluciones", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdVentaBuscada)

    <div class="row g-2 align-items-end mb-3">
        <div class="col-sm-4">
            @Html.Label("IdVenta", "N° de venta", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.IdVenta, new { @class = "form-control" })
        </div>
        <div class="col-sm-4">
            <button type="submit" name="accion" value="buscar" class="btn btn-outline-primary">Buscar productos</button>
        </div>
    </div>

    if (Model.Productos.Count > 0)
    {
        <h4>Productos de la venta</h4>
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Seleccionar</th>
                    <th>Producto</th>
                    <th class="text-end">Vendida</th>
                    <th class="text-end">Devuelta</th>
                    <th class="text-end">Pendiente</th>
                    <th class="text-end">Precio</th>
                    <th style="width:9rem">Cantidad a devolver</th>
                    <th>Reingresa a inventario</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Productos.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.CheckBoxFor(m => m.Productos[i].Seleccionado, new { @class = "form-check-input" })
                            @Html.HiddenFor(m => m.Productos[i].IdProducto)
                            @Html.HiddenFor(m => m.Productos[i].NombreProducto)
                            @Html.HiddenFor(m => m.Productos[i].CantidadVendida)
                            @Html.HiddenFor(m => m.Productos[i].CantidadDevuelta)
                            @Html.HiddenFor(m => m.Productos[i].CantidadPendiente)
                            @Html.HiddenFor(m => m.Productos[i].PrecioVenta)
                        </td>
                        <td>@Model.Productos[i].NombreProducto</td>
                        <td class="text-end">@Model.Productos[i].CantidadVendida</td>
                        <td class="text-end">@Model.Productos[i].CantidadDevuelta</td>
                        <td class="text-end">@Model.Productos[i].CantidadPendiente</td>
                        <td class="text-end">@Model.Productos[i].PrecioVenta.ToString("N2")</td>
                        <td>@Html.TextBoxFor(m => m.Productos[i].CantidadADevolver, new { @class = "form-control form-control-sm" })</td>
                        <td>@Html.CheckBoxFor(m => m.Productos[i].ReingresaInventario, new { @class = "form-check-input" })</td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" name="accion" value="agregar" class="btn btn-outline-secondary mb-4">Agregar al detalle</button>
    }

    <h4>Detalle de la devolución</h4>
    if (Model.Detalle.Count == 0)
    {
        <p class="text-muted">Todavía no agregó productos.</p>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Subtotal</th>
                    <th>Reingresa a inventario</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Detalle.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Detalle[i].NombreProducto
                            @Html.HiddenFor(m => m.Detalle[i].IdProducto)
                            @Html.HiddenFor(m => m.Detalle[i].NombreProducto)
                            @Html.HiddenFor(m => m.Detalle[i].Cantidad)
                            @Html.HiddenFor(m => m.Detalle[i].PrecioVenta)
                            @Html.HiddenFor(m => m.Detalle[i].ReingresaInventario)
                        </td>
                        <td class="text-end">@Model.Detalle[i].Cantidad</td>
                        <td class="text-end">@Model.Detalle[i].PrecioVenta.ToString("N2")</td>
                        <td class="text-end">@Model.Detalle[i].Subtotal.ToString("N2")</td>
                        <td>@(Model.Detalle[i].ReingresaInventario ? "Sí" : "No")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total estimado</th>
                    <th class="text-end">@Model.TotalDetalle.ToString("N2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    }

    <div class="mb-3">
        @Html.Label("Motivo", "Motivo de la devolución", new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Motivo, new { @class = "form-control", rows = 2, maxlength = 255 })
    </div>

    <button type="submit" name="accion" value="confirmar" class="btn btn-success">Confirmar devolución</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-link" })
}
