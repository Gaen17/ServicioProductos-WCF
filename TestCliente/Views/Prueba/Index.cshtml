@model TestCliente.ServicioProductosRef.RespuestaListaProductos
@{
    ViewBag.Title = "Prueba";
}
<h2 class="mt-3">Connectivity test: ListarProductos</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model != null && Model.Exito)
{
    <div class="alert alert-success">@Model.Mensaje</div>
    if (Model.Productos == null || Model.Productos.Count == 0)
    {
        <p>The service returned no products.</p>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Productos)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nombre</td>
                        <td>@p.CategoriaNombre</td>
                        <td class="text-end">@p.Precio.ToString("N2")</td>
                        <td class="text-end">@p.Stock</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
